# 环境变量配置模板
# 复制此文件为 .env 并根据实际环境修改

# 数据库配置
DB_USER=registry
DB_PASSWORD=registry
DB_NAME=registry

# JWT配置
JWT_SECRET=hub-registry-jwt-secret-2024

# S3/MinIO配置
S3_BUCKET=registry
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Registry外部访问配置
REGISTRY_HOST=localhost
REGISTRY_PORT=5000

# 外部访问地址（用于生成拉取命令）
EXTERNAL_HOST=hub.auok.online
EXTERNAL_PORT=50000